{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/display/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/pintrip-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Quicksand|Caveat|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Quicksand, Caveat, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnalyzeStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:iconSrc|text|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<AnalyzeStatus> doesn't accept that prop. Declared props: iconSrc, text, emphasis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:onBack|backIconSrc|wordmarkSrc|wordmarkVariant|wordmarkSize|sticker|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: onBack, backIconSrc, wordmarkSrc, wordmarkVariant, wordmarkSize, sticker, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='wordmarkVariant'] > Literal[value!=/^(?:serif|script)$/]",
        "message": "<AppHeader> wordmarkVariant must be one of 'serif' | 'script'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|alt|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, size, alt, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchAddPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|luggageSrc|sparkleSrc|style|key|ref|className|style|children)$/]",
        "message": "<BatchAddPanel> doesn't accept that prop. Declared props: title, subtitle, luggageSrc, sparkleSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|iconSrc|key|ref|className|style|children)$/]",
        "message": "<BottomNavItem> doesn't accept that prop. Declared props: id, label, iconSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|iconSrc|icon|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, iconSrc, icon, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|action|solid|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'action' | 'solid' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|tail|style|key|ref|className|style|children)$/]",
        "message": "<CategoryBadge> doesn't accept that prop. Declared props: kind, label, tail, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBadge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:cafe|food|attraction|stay|shop)$/]",
        "message": "<CategoryBadge> kind must be one of 'cafe' | 'food' | 'attraction' | 'stay' | 'shop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|style|key|ref|className|style|children)$/]",
        "message": "<CategoryIcon> doesn't accept that prop. Declared props: src, alt, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FabButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|size|label|style|key|ref|className|style|children)$/]",
        "message": "<FabButton> doesn't accept that prop. Declared props: onClick, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:iconSrc|glyph|size|variant|onClick|label|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: iconSrc, glyph, size, variant, onClick, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:paper|flat|tint)$/]",
        "message": "<IconButton> variant must be one of 'paper' | 'flat' | 'tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|iconSrc|onChange|onClear|style|key|ref|className|style|children)$/]",
        "message": "<LinkInput> doesn't accept that prop. Declared props: value, placeholder, iconSrc, onChange, onClear, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|iconSrc|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<LocationLine> doesn't accept that prop. Declared props: text, iconSrc, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|blue)$/]",
        "message": "<LocationLine> tone must be one of 'coral' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|rotate|tapeColor|width|style|key|ref|className|style|children)$/]",
        "message": "<NoteCard> doesn't accept that prop. Declared props: children, rotate, tapeColor, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceResultCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photoSrc|category|categoryLabel|name|description|address|tags|pinSrc|editIconSrc|markSrc|onEdit|onAdd|added|editLabel|addLabel|addedLabel|tape|stamp|style|key|ref|className|style|children)$/]",
        "message": "<PlaceResultCard> doesn't accept that prop. Declared props: photoSrc, category, categoryLabel, name, description, address, tags, pinSrc, editIconSrc, markSrc, onEdit, onAdd, added, editLabel, addLabel, addedLabel, tape, stamp, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceResultCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:cafe|food|attraction|stay|shop)$/]",
        "message": "<PlaceResultCard> category must be one of 'cafe' | 'food' | 'attraction' | 'stay' | 'shop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|highlight|style|key|ref|className|style|children)$/]",
        "message": "<ScreenTitle> doesn't accept that prop. Declared props: title, subtitle, highlight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StartTripCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|mapSrc|onClick|tape|style|key|ref|className|style|children)$/]",
        "message": "<StartTripCard> doesn't accept that prop. Declared props: title, description, mapSrc, onClick, tape, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|pattern|color|src|alt|rotate|width|height|position|style|children|key|ref|className|style|children)$/]",
        "message": "<Sticker> doesn't accept that prop. Declared props: type, pattern, color, src, alt, rotate, width, height, position, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:tape|image)$/]",
        "message": "<Sticker> type must be one of 'tape' | 'image'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='pattern'] > Literal[value!=/^(?:solid|gingham|dots)$/]",
        "message": "<Sticker> pattern must be one of 'solid' | 'gingham' | 'dots'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|butter|lavender)$/]",
        "message": "<Tag> tone must be one of 'blue' | 'butter' | 'lavender'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|location|note|placeCount|countLabel|photoSrc|pinSrc|icons|onMenu|onClick|sticker|style|key|ref|className|style|children)$/]",
        "message": "<TripCard> doesn't accept that prop. Declared props: title, location, note, placeCount, countLabel, photoSrc, pinSrc, icons, onMenu, onClick, sticker, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|src|size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: variant, src, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:serif|script)$/]",
        "message": "<Wordmark> variant must be one of 'serif' | 'script'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
